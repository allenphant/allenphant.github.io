---
import { existsSync } from "node:fs";
import { join } from "node:path";
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Allen — NTU Biochem M.S. Python automation, bio-image analysis, and problem-solving through code.",
  ogImage = "/og-image.png",
} = Astro.props;

const siteTitle = `${title} | allenphant`;
const siteUrl = Astro.site || "https://allenphant.github.io";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
// Social previews need an absolute image URL. Only emit the image tags when
// the file is actually in public/, so they never point at a 404.
const hasOgImage = /^https?:\/\//.test(ogImage) || existsSync(join(process.cwd(), "public", ogImage));
const ogImageUrl = hasOgImage ? new URL(ogImage, siteUrl).href : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:alt" content="allenphant — Allen (JuiChun Wang), lab automation and bio-image analysis" />}
    {ogImage === "/og-image.png" && ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImage === "/og-image.png" && ogImageUrl && <meta property="og:image:height" content="630" />}
    <meta property="og:url" content={canonicalUrl} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Body font: self-hosted Latin subset of Noto Sans JP (see global.css) -->
    <link rel="preload" href="/fonts/noto-sans-jp-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Google Fonts (headings + mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,300;1,400;1,600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{siteTitle}</title>
  </head>
  <body class="flex flex-col min-h-screen">
    <Navbar />
    <main class="flex-1 pt-16">
      <slot />
    </main>
    <Footer />
  </body>
</html>
