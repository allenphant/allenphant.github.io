---
// Language-distribution doughnut, rendered to static SVG at build time.
// Replaces a Chart.js React island (~55 KB gzip of JS for a chart that never
// changes after build). Hovering a segment shows a native tooltip.
import type { LanguageStats } from "../lib/types";

interface Props {
  languages: LanguageStats[];
}

const { languages } = Astro.props;

const top = languages.slice(0, 10);
const otherSize = languages.slice(10).reduce((sum, l) => sum + l.size, 0);
const total = languages.reduce((sum, l) => sum + l.size, 0) || 1;

const segments = top.map((l) => ({
  name: l.name,
  color: l.color || "#6366f1",
  size: l.size,
}));
if (otherSize > 0) segments.push({ name: "Other", color: "#475569", size: otherSize });

// Ring geometry: outer radius 50, inner 65% (same cutout as before).
const OUTER = 50;
const INNER = OUTER * 0.65;
const R = (OUTER + INNER) / 2;
const STROKE = OUTER - INNER;
const C = 2 * Math.PI * R;
const GAP = segments.length > 1 ? 0.6 : 0; // hairline gap between segments

let offset = 0;
const arcs = segments.map((s) => {
  const len = (s.size / total) * C;
  const arc = {
    ...s,
    pct: ((s.size / total) * 100).toFixed(1),
    dash: `${Math.max(len - GAP, 0.01)} ${C}`,
    offset: -offset,
  };
  offset += len;
  return arc;
});

const label = `Language distribution chart: ${top.map((l) => `${l.name} ${l.percentage}%`).join(", ")}`;
---

<div class="flex flex-col lg:flex-row items-center gap-12" role="img" aria-label={label}>
  {/* Chart */}
  <div class="w-64 h-64 sm:w-80 sm:h-80">
    <svg viewBox="0 0 100 100" class="w-full h-full -rotate-90" aria-hidden="true">
      {arcs.map((a) => (
        <circle
          class="skill-arc"
          cx="50"
          cy="50"
          r={R}
          fill="none"
          stroke={a.color}
          stroke-width={STROKE}
          stroke-dasharray={a.dash}
          stroke-dashoffset={a.offset}
        >
          <title>{`${a.name}: ${a.pct}%`}</title>
        </circle>
      ))}
    </svg>
  </div>

  {/* Legend */}
  <div class="flex-1 grid grid-cols-2 gap-3 w-full">
    {top.map((lang) => (
      <div class="flex items-center gap-3 p-3 rounded-xl bg-black/[0.03] border border-black/[0.06]">
        <span class="w-3 h-3 rounded-full shrink-0" style={`background-color: ${lang.color}`}></span>
        <div class="min-w-0 flex-1">
          <div class="text-sm font-medium text-[#2D2D2D] truncate">{lang.name}</div>
          <div class="text-xs text-[#5A5A5A]">{lang.percentage}%</div>
        </div>
        {/* Mini bar */}
        <div class="w-16 h-1.5 bg-black/[0.06] rounded-full overflow-hidden">
          <div
            class="h-full rounded-full"
            style={`width: ${Math.min(lang.percentage * 2, 100)}%; background-color: ${lang.color}`}
          ></div>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .skill-arc {
    opacity: 0.85;
    transition: opacity 200ms ease;
  }
  .skill-arc:hover {
    opacity: 1;
  }
</style>
